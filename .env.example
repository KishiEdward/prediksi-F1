# Salin file ini menjadi .env lalu sesuaikan isinya.
# Semua path bersifat relatif terhadap root proyek kecuali ditulis absolut.

# Domain website yang diizinkan mengakses API (pisahkan dengan koma).
# Contoh: F1_API_CORS_ORIGINS=["http://localhost:3000","https://webku.com"]
F1_API_CORS_ORIGINS=["*"]

# Basis URL Jolpica F1 API
F1_JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1/

# Jeda minimum antar request ke Jolpica (detik) untuk menghormati rate limit
F1_JOLPICA_MIN_INTERVAL=0.5

# Rentang musim data
F1_SEASON_START=2021
F1_SEASON_END=2025

# Lokasi cache FastF1 (relatif terhadap root proyek)
F1_FASTF1_CACHE_DIR=data/raw/fastf1_cache

# Port server API
F1_API_PORT=8000

# Kredensial akun F1 (GRATIS daftar di https://account.formula1.com)
# SALIN ke .env dan isi sendiri; .env tidak pernah di-commit ke git.
F1_USERNAME=
F1_PASSWORD=
